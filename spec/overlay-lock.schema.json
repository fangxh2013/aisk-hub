{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiskOverlayExternalLock",
  "type": "object",
  "required": [
    "lock_version",
    "manifest_id",
    "overlay_digest",
    "kernel_commit",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "lock_version": {
      "type": "integer",
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "overlay_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kernel_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
