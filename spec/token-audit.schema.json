{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisk.example/spec/token-audit.schema.json",
  "title": "Token Runtime privacy-safe audit record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "at", "session_id", "metadata", "token_count", "mode", "trigger", "fallback", "result", "source_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "at": {"type": "string", "format": "date-time"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "metadata": {"$ref": "#/$defs/metadata"},
    "token_count": {"type": "integer", "minimum": 0},
    "token_counts": {"$ref": "#/$defs/token_counts"},
    "mode": {"enum": ["lite", "standard", "deep", "emergency"]},
    "trigger": {"type": "string", "minLength": 1, "maxLength": 128},
    "fallback": {"type": "string", "minLength": 1, "maxLength": 128},
    "result": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "classification": {"enum": ["PUBLIC", "INTERNAL_TEMPLATE", "CONFIDENTIAL", "SECRET"]},
        "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "loaded_at": {"type": "string", "format": "date-time"}
      }
    },
    "token_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "total"],
      "properties": {
        "input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    }
  }
}
